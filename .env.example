# Copia este archivo como .env y ajusta los valores.

# Cadena de conexión a PostgreSQL (con PostGIS habilitado).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgp_tulua"

# --- Correo (SMTP) ---
# Si MAIL_HOST queda vacío en desarrollo, el código de activación se
# escribe en el log del servidor en lugar de enviarse.
MAIL_HOST=
MAIL_PORT=587
# true para TLS desde el inicio (puerto 465); false usa STARTTLS (587).
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="SGP Tulua <no-reply@sgptulua.gov.co>"

# URL del frontend; se usa para el enlace de acceso del correo de invitación
# de gestores.
FRONTEND_URL=http://localhost:3001

# Vigencia del código de activación, en minutos.
ACTIVATION_CODE_TTL_MINUTES=15

# Vigencia del código de recuperación de contraseña, en minutos.
PASSWORD_RECOVERY_CODE_TTL_MINUTES=2

# --- Autenticación (JWT) ---
# Secreto de firma. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-produccion
# Vigencia del token de comerciantes y organizadores (8 horas).
JWT_EXPIRES_IN_SECONDS=28800
# Vigencia del token de gestores (30 minutos, HU-06).
JWT_GESTOR_EXPIRES_IN_SECONDS=1800
# Intentos fallidos consecutivos antes de bloquear la cuenta.
LOGIN_MAX_ATTEMPTS=5
# Duración del bloqueo, en minutos.
LOGIN_LOCK_MINUTES=15

# --- Rate limit del login (por IP) ---
# Máximo de peticiones a /auth/login por IP dentro de la ventana.
LOGIN_RATE_LIMIT_MAX=10
# Ventana del rate limit, en milisegundos (1 minuto).
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Activar solo detrás de un proxy inverso: hace que request.ip use
# X-Forwarded-For. En desarrollo debe quedar en false.
TRUST_PROXY=false
